# ========= Окошко — environment variables =========
# Copy to .env and adjust values.

# ---- Database (matches docker-compose service "db") ----
DATABASE_URL="mysql://okoshko:okoshko@db:3306/okoshko"

# For local dev without Docker use localhost:
# DATABASE_URL="mysql://okoshko:okoshko@127.0.0.1:3306/okoshko"

# ---- App ----
APP_PORT=3000
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"

# MySQL (used by docker-compose)
MYSQL_ROOT_PASSWORD="rootpass"
MYSQL_PASSWORD="okoshko"

# ---- Telegram bot (stage 5) ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Bot username without @, used to build the binding link
TELEGRAM_BOT_USERNAME="OkoshkoBot"

# ---- Reminders cron endpoint (stage 5) ----
# GET /api/cron/reminders with header "x-cron-secret"
CRON_SECRET="change-me"

# ---- Payments (stage 6) ----
# "mock" for local development, "yookassa" for real payments
PAYMENT_PROVIDER="mock"
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
